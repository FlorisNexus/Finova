<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>

        <PackageId>Finova.Extensions.FluentValidation</PackageId>
        <Title>Finova Extensions for FluentValidation</Title>
        <Description>
            FluentValidation extensions for the Finova financial toolkit.
            Easily validate IBANs, BICs, Payment Cards, VAT numbers, and National IDs.
            Includes specialized aliases: .MustBeValidABARoutingNumber(), .MustBeValidSiret(),
            .MustBeValidSiren(), .MustBeValidOgm(), etc.
        </Description>
        <PackageTags>
            finova;fluentvalidation;validation;extensions;banking;vat;enterprise;tax-id;national-id;fluent;rules;property-validator;routing-number;aba;ach;transit-number;bsb;siret;siren;kbo;ogm;isorf</PackageTags>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Finova\Finova.csproj" />

    </ItemGroup>

</Project>